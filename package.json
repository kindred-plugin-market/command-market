{
  "name": "bench-command-market",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Bench \u547d\u4ee4/\u89c4\u5219\u5e02\u573a \u2014 \u6570\u636e\u771f\u6e90\u4e0e\u7d22\u5f15\u751f\u6210",
  "scripts": {
